# renders and intermediates (regenerate them instead of committing)
*.mp4
*.wav
reel/frames.mp4
reel/stills/
email-motion/stills/
reel/music/
**/node_modules/
__pycache__/
*.bak.html
*.bak.js
*.bak.py

# raw uploads stay local (full size); the web-ready copies in library/ are tracked
media/
library/_staging/
library-build.log
!library/**
library/_staging/**

# template render caches
**/.work/
# template sample renders: commit contact sheets, not the per-frame review stills (MP4s stay ignored like every render)
templates/samples/**/stills/

# explainer kit review stills (large); the *-stills.jpg contact sheet is committed instead
posts/bank-*/reel/stills/
posts/2026-11-05-intro-reel/stills/
